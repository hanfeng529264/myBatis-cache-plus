<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hanfeng529264</groupId>
    <artifactId>mybatis-cache-plus</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mybatis-cache-plus</name>
    <description>MyBatis Cache Plus - 高性能多级缓存框架</description>
    <url>https://github.com/hanfeng529264/mybatis-cache-plus</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>hanfeng529264</name>
            <url>https://github.com/hanfeng529264</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/hanfeng529264/mybatis-cache-plus.git</connection>
        <developerConnection>scm:git:ssh://github.com/hanfeng529264/mybatis-cache-plus.git</developerConnection>
        <url>https://github.com/hanfeng529264/mybatis-cache-plus</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>mbcp-annotation</module>
        <module>mbcp-cache-api</module>
        <module>mbcp-cache-local</module>
        <module>mbcp-cache-redis</module>
        <module>mbcp-cache-multilevel</module>
        <module>mbcp-core</module>
        <module>mbcp-monitor</module>
        <module>mbcp-spring-boot-starter</module>
        <module>mbcp-example</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 第三方版本 -->
        <redisson.version>3.29.0</redisson.version>
        <guava.version>33.2.0-jre</guava.version>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <shardingsphere.version>5.5.1</shardingsphere.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 BOM -->
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-annotation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-cache-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-cache-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-cache-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-cache-multilevel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hanfeng529264</groupId>
                <artifactId>mbcp-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 外部依赖版本锁定 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
                <optional>true</optional>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 生成 Sources JAR（Maven Central 必须） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 生成 Javadoc JAR（Maven Central 必须） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- 避免注释不规范导致构建失败 -->
                    <doclint>none</doclint>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- GPG 签名（Maven Central 必须） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Sonatype Central 发布插件 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.5.0</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- 对应 ~/.m2/settings.xml 中的 <server id="central"> -->
                    <publishingServerId>central</publishingServerId>
                    <!-- false：上传后需要在网页手动点 Publish 确认，建议首次使用 false -->
                    <autoPublish>false</autoPublish>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
